{
  "name": "tinny-backend",
  "version": "1.1.2",
  "description": "A lightweight and flexible backend framework built on Node.js.",
  "license": "MIT",
  "author": {
    "name": "Yassine Ajagrou",
    "email": "yassineajagrou8@gmail.com",
    "url": "https://github.com/iaceene"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iaceene/tinny-backend.git"
  },
  "bugs": {
    "url": "https://github.com/iaceene/tinny-backend/issues"
  },
  "homepage": "https://github.com/iaceene/tinny-backend#readme",
  "keywords": [
    "backend",
    "framework",
    "router",
    "routing",
    "http",
    "node",
    "nodejs",
    "typescript",
    "server"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test-ws": "tsx src/test/ws.test.ts",
    "test-use": "tsx src/test/use.test.ts",
    "test-sendFile": "tsx src/test/sendFile.test.ts",
    "test-servDir": "tsx src/test/servDir.test.ts",
    "test": "vitest run src/test/framework.spec.ts",
    "test:bun": "bun test src/test/framework.spec.ts",
    "docs:build": "bun run docs/build.ts",
    "docs:preview": "bun run docs/preview.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^9.36.0",
    "lucide-react": "^1.61.0",
    "prettier": "^3.6.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.13.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "dependencies": {
    "ws": "^8.21.3"
  }
}
